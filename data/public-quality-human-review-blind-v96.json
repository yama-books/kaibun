  "rubric": {
    "grammar": {
      "values": [
        "pass",
        "marginal",
        "fail"
      ],
      "definitions": {
        "pass": "Ordinary or clearly acceptable Japanese construction.",
        "marginal": "Recoverable Japanese, but ellipsis, attachment, or phrasing is noticeably strained.",
        "fail": "Construction does not work as Japanese without substantial repair."
      }
    },
    "semantic_coherence": {
      "values": [
        "clear",
        "strained",
        "opaque"
      ],
      "definitions": {
        "clear": "The described situation or relation is readily interpretable.",
        "strained": "Interpretation is possible but selectional relation, reference, or modification feels forced.",
        "opaque": "No stable intended meaning can be recovered."
      }
    },
    "display_reading_fidelity": {
      "values": [
        "pass",
        "hint-needed",
        "mismatch"
      ],
      "definitions": {
        "pass": "The displayed form reasonably supports the intended kana reading.",
        "hint-needed": "The reading is legitimate/intended but the display is liable to be read another way.",
        "mismatch": "The display does not reasonably support the canonical reading."
      }
    },
    "productive_value": {
      "values": [
        "expand",
        "keep-only",
        "hold"
      ],
      "definitions": {
        "expand": "A useful pattern worth generating more examples from.",
        "keep-only": "This example can remain, but the pattern should not be expanded aggressively.",
        "hold": "Do not expose as a normal productive pattern without correction."
      }
    },
    "overall_naturalness": {
      "values": [
        1,
        2,
        3,
        4,
        5
      ],
      "definitions": {
        "1": "Broken or essentially uninterpretable.",
        "2": "Understandable only with substantial strain.",
        "3": "Odd but works as a deliberate 怪文.",
        "4": "Good Japanese with a noticeable palindrome/wordplay flavor.",
        "5": "Natural enough that the palindrome constraint barely intrudes."
      }
    },
    "confidence": {
      "values": [
        "low",
        "medium",
        "high"
      ]
    }
  },
