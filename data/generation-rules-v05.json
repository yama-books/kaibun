{
  "version": "0.5",
  "principle": "L1では文字列対称性より先に、日本語として自然な完成文が得られる語彙スロットのみ許可する。自由な文字代入は禁止。",
  "rules": [
    {
      "id": "L1-WATASHI-GA",
      "reading_pattern": "わたしが{c}がしたわ",
      "description": "語境界が鏡面をまたぐ。左の「が」は主格助詞、右側の「が」は動詞語幹の一部になる。",
      "examples": [
        "私が探したわ。",
        "私が流したわ。",
        "私が剥がしたわ。"
      ],
      "slots": [
        {
          "c": "さ",
          "display": "私が探したわ。",
          "lemma": "探す"
        },
        {
          "c": "な",
          "display": "私が流したわ。",
          "lemma": "流す"
        },
        {
          "c": "は",
          "display": "私が剥がしたわ。",
          "lemma": "剥がす"
        },
        {
          "c": "に",
          "display": "私が逃がしたわ。",
          "lemma": "逃がす"
        },
        {
          "c": "こ",
          "display": "私が焦がしたわ。",
          "lemma": "焦がす"
        },
        {
          "c": "け",
          "display": "私が怪我したわ。",
          "lemma": "怪我する"
        },
        {
          "c": "よ",
          "display": "私がヨガしたわ。",
          "lemma": "ヨガする"
        }
      ]
    },
    {
      "id": "L1-WATASHI-MO",
      "reading_pattern": "わたしも{c}もしたわ",
      "description": "左の「も」は係助詞、右側の「も」は名詞末尾として再解釈される。",
      "examples": [
        "私もメモしたわ。",
        "私もデモしたわ。"
      ],
      "slots": [
        {
          "c": "め",
          "display": "私もメモしたわ。",
          "lemma": "メモする"
        },
        {
          "c": "で",
          "display": "私もデモしたわ。",
          "lemma": "デモする"
        }
      ]
    },
    {
      "id": "L1-YOKU-KUYO",
      "reading_pattern": "よく{c}くよ",
      "description": "自然な五段動詞だけをホワイトリストで許可する。",
      "examples": [
        "よく聞くよ。",
        "よく泣くよ。",
        "よく書くよ。"
      ],
      "slots": [
        {
          "c": "き",
          "display": "よく聞くよ。",
          "lemma": "聞く"
        },
        {
          "c": "な",
          "display": "よく泣くよ。",
          "lemma": "泣く"
        },
        {
          "c": "か",
          "display": "よく書くよ。",
          "lemma": "書く"
        },
        {
          "c": "と",
          "display": "よく解くよ。",
          "lemma": "解く"
        },
        {
          "c": "お",
          "display": "よく置くよ。",
          "lemma": "置く"
        },
        {
          "c": "や",
          "display": "よく焼くよ。",
          "lemma": "焼く"
        },
        {
          "c": "ひ",
          "display": "よく引くよ。",
          "lemma": "引く"
        },
        {
          "c": "ふ",
          "display": "よく拭くよ。",
          "lemma": "拭く"
        },
        {
          "c": "た",
          "display": "よく炊くよ。",
          "lemma": "炊く"
        },
        {
          "c": "は",
          "display": "よく履くよ。",
          "lemma": "履く"
        },
        {
          "c": "む",
          "display": "よく剥くよ。",
          "lemma": "剥く"
        },
        {
          "c": "つ",
          "display": "よく付くよ。",
          "lemma": "付く"
        },
        {
          "c": "い",
          "display": "よく行くよ。",
          "lemma": "行く"
        },
        {
          "c": "さ",
          "display": "よく咲くよ。",
          "lemma": "咲く"
        },
        {
          "c": "あ",
          "display": "よく空くよ。",
          "lemma": "空く"
        },
        {
          "c": "わ",
          "display": "よく湧くよ。",
          "lemma": "湧く"
        },
        {
          "c": "ま",
          "display": "よく巻くよ。",
          "lemma": "巻く"
        }
      ]
    },
    {
      "id": "L1-YORU-RUYO",
      "reading_pattern": "よる{c}るよ",
      "description": "「夜」を時の副詞的名詞として使い、自然なル動詞だけを許可する。",
      "examples": [
        "夜、寝るよ。",
        "夜、見るよ。",
        "夜、来るよ。"
      ],
      "slots": [
        {
          "c": "ね",
          "display": "夜、寝るよ。",
          "lemma": "寝る"
        },
        {
          "c": "み",
          "display": "夜、見るよ。",
          "lemma": "見る"
        },
        {
          "c": "で",
          "display": "夜、出るよ。",
          "lemma": "出る"
        },
        {
          "c": "く",
          "display": "夜、来るよ。",
          "lemma": "来る"
        },
        {
          "c": "い",
          "display": "夜、いるよ。",
          "lemma": "いる"
        },
        {
          "c": "に",
          "display": "夜、煮るよ。",
          "lemma": "煮る"
        },
        {
          "c": "き",
          "display": "夜、着るよ。",
          "lemma": "着る"
        },
        {
          "c": "け",
          "display": "夜、蹴るよ。",
          "lemma": "蹴る"
        }
      ]
    },
    {
      "id": "L2-DANNA-NANDA",
      "reading_pattern": "だんな{pal_center}なんだ",
      "description": "意味は通る口語同定。L1には入れず、L2怪文DNAとして扱う。",
      "examples": [
        "旦那、キキなんだ。",
        "旦那、石井なんだ。"
      ],
      "constraint": "中心語はそれ自体が回文で、人物名・呼称として解釈可能なものに限定する。"
    },
    {
      "id": "L1-TASHIKANI-LOAN",
      "reading_pattern": "たしかに{pal_center}にかした",
      "description": "「確かに、Xに貸した。」。中心語が人名・人物ならL1、動物・異常対象ならL2へ自動昇格する。",
      "examples": [
        "確かに、母に貸した。",
        "確かに、キキに貸した。",
        "確かに、庭のワニに貸した。"
      ],
      "layer_rule": "human/person => L1; animal/odd target => L2"
    }
  ]
}