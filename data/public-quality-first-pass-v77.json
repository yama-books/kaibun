  "key_findings": [
    "Most sampled L1 constructions are grammatically recoverable; the main weakness is template-like kinship/genitive stacking rather than outright grammar failure.",
    "QB-021 is borderline for L1 because 今朝のキキの酒 stacks temporal/genitive modification in a forced way.",
    "QB-042 is the clearest L2 hold: 声のエコ + 見た compounds two semantic-role mismatches.",
    "Ambiguous kanji readings deserve a separate display-reading fidelity check even when the normalized kana is a strict palindrome.",
    "The bridge sample itself produced no preliminary hold; semantic-role filtering appears to be doing useful work on this small fixed sample."
  ],
  "priority_actions": [
    {
      "priority": 1,
      "target": "QB-042 / voice-eco seam family",
      "action": "review or demote from productive generation; avoid expanding this semantic pairing."
    },
    {
      "priority": 2,
      "target": "QB-021 / time-see nested genitive",
      "action": "review L1 placement or display segmentation."
    },
    {
      "priority": 3,
      "target": "ambiguous display readings",
      "action": "add reading-fidelity metadata or furigana strategy for items such as 魚 and 高田."
    },
    {
      "priority": 4,
      "target": "kinship templates",
      "action": "keep grammatically valid outputs but cap repetition/diversify lexical frames rather than treating all A labels as equally natural."
    }
  ],
