  "final_human_adjudication_required": true,
  "caveat": "These labels are diagnostic judgments, not a human study and not ground-truth naturalness scores.",
  "rubric": {
    "grammar": "2=acceptable Japanese construction, 1=elliptical/marginal but recoverable, 0=broken",
    "semantic_coherence": "2=clear, 1=interpretable with strain/odd relation, 0=opaque or selectionally broken",
    "productive_value": "2=useful pattern to generate more from, 1=limited/repetitive, 0=avoid expanding",
    "display_reading_fidelity": "pass=display reasonably supports intended reading, warn=ambiguous reading/display, fail=mismatch",
    "layer_fit": "keep=appropriate for current layer, review=borderline, hold=should not remain without correction"
  },
