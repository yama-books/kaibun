{
  "version": "0.25",
  "name": "seam-shift grammar",
  "thesis": "鏡像制約はかな列に課す。語境界・品詞・統語役割は左右一対一にそろえず、完成した全文の日本語として評価する。",
  "reference_specimens": [
    {
      "id": "takarabune-kaibunka",
      "display": "長き夜の 遠の眠りの 皆目覚め 波乗り舟の 音の良きかな",
      "normalized_reading": "なかきよのとをのねふりのみなめさめなみのりふねのをとのよきかな",
      "strict_palindrome_under_normalization": true,
      "meter": [
        5,
        7,
        5,
        7,
        7
      ],
      "historical_note": "江戸期の宝船・初夢習俗で著名だが、成立時期・作者は不詳。国立国会図書館レファレンス協同DBは1592年刊『日本風土記』掲載を確認し、参考資料では1548年成立『運歩色葉集』も古い出典として挙げる。",
      "source_notes": [
        "国立国会図書館 レファレンス協同データベース 管理番号 いわき総合-一般307",
        "精選版日本国語大辞典／日本大百科全書『回文歌』『回文』"
      ],
      "tokenization": [
        [
          "長き",
          "なかき"
        ],
        [
          "夜",
          "よ"
        ],
        [
          "の",
          "の"
        ],
        [
          "遠",
          "とを"
        ],
        [
          "の",
          "の"
        ],
        [
          "眠り",
          "ねふり"
        ],
        [
          "の",
          "の"
        ],
        [
          "皆",
          "みな"
        ],
        [
          "目覚め",
          "めさめ"
        ],
        [
          "波",
          "なみ"
        ],
        [
          "乗り舟",
          "のりふね"
        ],
        [
          "の",
          "の"
        ],
        [
          "音",
          "をと"
        ],
        [
          "の",
          "の"
        ],
        [
          "良き",
          "よき"
        ],
        [
          "かな",
          "かな"
        ]
      ],
      "structural_observations": [
        "みな（皆）↔ なみ（波）: 同じ音の鏡像が、主語と次の名詞句の先頭という別の統語役割を持つ。",
        "めさめ（目覚め）が自己回文の述語ピボットになる。",
        "とを（遠）↔ をと（音）: 異なる名詞を逆読みで接続する。",
        "ねふり（眠り）の反転『りふね』は単独語ではなく、隣接する『の』と再分節され『のりふね（乗り舟）』になる。",
        "なかきよ（長き夜）↔ よきかな（良きかな）: 名詞句と評価的終止が対応し、品詞・句構造が左右で一致しない。",
        "5-7-5-7-7の句境界そのものは鏡像位置と一致しない。韻律と回文軸を別々に成立させている。"
      ]
    }
  ],
  "principles": [
    {
      "id": "kana-first",
      "label": "かな列優先",
      "description": "回文制約は文字・音列にだけ課し、語単位の鏡像対応を要求しない。"
    },
    {
      "id": "boundary-shift",
      "label": "境界ずらし",
      "description": "『この↔の子』『眠り↔（の）り舟』のように、鏡像位置と形態素境界をずらす。"
    },
    {
      "id": "role-shift",
      "label": "役割転換",
      "description": "鏡像する音列が左右で別の品詞・統語役割を持ってよい。"
    },
    {
      "id": "particle-hinge",
      "label": "助詞ヒンジ",
      "description": "の・に・も等を中央または殻として置き、前後の語の所属を変えながら文法をつなぐ。"
    },
    {
      "id": "semantic-pivot",
      "label": "意味ピボット",
      "description": "中心に自己回文の述語・名詞を置き、左右の異なる意味領域を接続する。"
    },
    {
      "id": "whole-parse",
      "label": "全文評価",
      "description": "各ペア単体の自然さではなく、完成文全体の構文・意味・韻律で採否を決める。"
    }
  ],
